MONGODB_URI=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
OPENROUTER_API_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/

# Stripe secret key (server only). Never prefix with NEXT_PUBLIC_.
STRIPE_SECRET_KEY=
STRIPE_CONTEXT=
# Optional webhook secret once webhook endpoint is configured
STRIPE_WEBHOOK_SECRET=

# Comma-separated Clerk emails allowed into /admin
ADMIN_EMAILS=you@example.com

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Cloudflare R2 (bonus showreel uploads). Create an R2 bucket + API token with Object Read & Write.
# R2_PUBLIC_BASE_URL should be the public bucket URL (r2.dev or custom domain), no trailing slash.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=
